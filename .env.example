# Server Configuration
PORT=3000
SESSION_SECRET=eetirp-secure-session-key

# AI Provider Configuration (Google Gemini or OpenAI)
# Gemini API Key (Recommended for high performance and live tutoring):
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API Key (Optional alternative):
# OPENAI_API_KEY=your_openai_api_key_here

# MongoDB Connection String (Required for cloud chat history storage)
# e.g., mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/eetirp?retryWrites=true&w=majority
MONGODB_URI=your_mongodb_connection_string_here


